{
  "name": "revoked-credential",
  "description": "An unknown credential, a revoked participant and a missing credential are the same 401. It never says which.",
  "request": {
    "method": "GET",
    "path": "/participant/v1/directory",
    "headers": {
      "Authorization": "Bearer FAKE-CREDENTIAL-FOR-EXAMPLES-ONLY"
    }
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json",
      "X-Ratatoskr-Contract": "1.0"
    },
    "body": {
      "code": "unauthorized",
      "message": "the credential was not accepted"
    }
  }
}
